# QQ Bot credentials from your own QQ Open Platform application.
QQ_APP_ID=YOUR_QQ_APP_ID
QQ_CLIENT_SECRET=YOUR_QQ_APP_SECRET
# Leave empty to bind the first user who sends the bot a private message.
QQ_TARGET_OPENID=

# Optional for NEWS-only use; required for the PAPER discovery workflow.
OPENALEX_API_KEY=YOUR_OPENALEX_API_KEY

# Optional Wiley Text and Data Mining API token for Wiley PDF fallback.
WILEY_TDM_API_TOKEN=

# OpenAI-compatible model endpoint. Replace all three values or leave all three empty.
MODEL_BASE_URL=https://api.example.com/v1
MODEL_API_KEY=YOUR_MODEL_API_KEY
MODEL_NAME=YOUR_MODEL_NAME

# Credentials from your own WeChat Official Account.
WECHAT_APP_ID=YOUR_WECHAT_APP_ID
WECHAT_APP_SECRET=YOUR_WECHAT_APP_SECRET
WECHAT_AUTHOR=YOUR_AUTHOR_NAME

# Candidate delivery schedule.
DAILY_PUSH_TIME=07:00
DAILY_TIMEZONE=Asia/Shanghai
